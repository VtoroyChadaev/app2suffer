<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/activity_a"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ActivityA">

<TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="@string/greetingActivityA"
    android:textSize="24sp"
    android:layout_marginTop="20sp"
    app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintLeft_toLeftOf="parent"
    app:layout_constraintRight_toRightOf="parent"
    />
<EditText
    android:id="@+id/colorEditText"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:inputType="text"
    android:hint="@string/colorPrompt"
    android:layout_marginBottom="20sp"
    app:layout_constraintBottom_toTopOf="@id/buttonGenerateColor"
    app:layout_constraintLeft_toLeftOf="@id/buttonGenerateColor"
    app:layout_constraintRight_toRightOf="@id/buttonGenerateColor"
    />
<Button
    android:id="@+id/buttonGenerateColor"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="@string/buttonGenerateColor"
    android:textSize="24sp"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent"
    />
<Button
    android:id="@+id/buttonOpenB"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="@string/ButtonOpenActivityB"
    android:textSize="24sp"
    android:layout_marginTop="24sp"
    app:layout_constraintTop_toBottomOf="@id/buttonGenerateColor"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    />
</androidx.constraintlayout.widget.ConstraintLayout>